# Copia este archivo a .env y ajusta lo que haga falta. Nada es obligatorio.

# Contacto que se manda a BeatSaver en cada búsqueda (una web o un correo),
# para que sepan a quién escribir si algo va mal.
SLICELIST_CONTACT=

# Spotify: no hace falta clave. El lector usa el embed público.

# Dónde escucha el lector de playlists (reader/server.py). Solo local.
READER_URL=http://127.0.0.1:4191

# Carpeta de la caché (SQLite). Por defecto, ./data
# SLICELIST_DATA_DIR=

# --- Lector (se leen al arrancar reader/server.py) ---
# READER_PORT=4191
# Tope de canciones que se leen de una playlist (por defecto 200).
# READER_MAX_TRACKS=200
